      "expected": [
        4
      ],
      "actual": [
        4
      ]
    },
    {
      "name": "nested",
      "source": "def outer():\n def inner(x):\n  return 1 if x else 2\n return inner\n",
      "expected": [
        1,
        2
      ],
      "actual": [
        1,
        2
      ]
    },
    {
      "name": "lambda",
      "source": "def outer():\n return lambda x: 1 if x else 2\n",
      "expected": [
        1,
        2
      ],
      "actual": [
        1,
        2
      ]
    },
    {
      "name": "definition-input",
      "source": "def outer(x):\n def inner(y=1 if x else 2):\n  return y\n return inner\n",
      "expected": [
        2,
        2
      ],
      "actual": [
        2,
        2
      ]
    },
    {
      "name": "header",
      "source": "@(first if flag else second)\ndef f(value=1 if flag else 2):\n return value\n",
      "expected": [
        3
      ],
      "actual": [
        3
      ]
    },
    {
      "name": "format-string",
      "source": "def f(x):\n return f\"{1 if x else 2:{3 if x else 4}}\"\n",
      "expected": [
        3
      ],
      "actual": [
        3
      ]
    },
    {
      "name": "annotations",
      "source": "def f(x: 1 if flag else 2) -> (3 if flag else 4):\n return x\n",
      "expected": [
        3
      ],
      "actual": [
        3
      ]
    },
    {
      "name": "comprehension",
      "source": "def f(xs):\n return [x for x in xs if x]\n",
      "expected": [
        3
      ],
      "actual": [
        3
      ]
    },
    {
      "name": "exceptions",
      "source": "def f():\n try:\n  return 1\n except ValueError:\n  return 2\n finally:\n  pass\n",
      "expected": [
        3
      ],
      "actual": [
        3
      ]
    },
    {
      "name": "async",
